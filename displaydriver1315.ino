  // Use font pointer from PROGMEM
  const unsigned char *p = &font[(uint16_t)c * 5];
  
  for (uint8_t col = 0; col < 5; col++) {
    uint8_t bits = pgm_read_byte(p + col);
    for (uint8_t row = 0; row < 8; row++) {
      if (bits & (1 << row)) {
        // Draw pixel directly using screen coordinates
        ssd1315_draw_pixel(x + col, 63-(y + row), 1);
      }
    }
  }
}

void draw_string(uint8_t x, uint8_t y, const char *s) {
  char c;
  // Read byte from Flash and increment pointer 's'
  while ((c = pgm_read_byte(s++))) {
    draw_c(x, y, (unsigned char)c);
    x += 6; // Move cursor right by 6 pixels
  }
}

void setup() {
  i2c_init();
  ssd1315_init();
}

void loop() {
  ssd1315_clear_buffer();
  draw_string(64, 32, PSTR("Hello"));
  ssd1315_update();
}
